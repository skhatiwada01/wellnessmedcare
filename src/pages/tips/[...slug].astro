---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import Support from '../../components/Support.astro';
import { TOPICS } from '../../content.config';

export async function getStaticPaths() {
  const tips = await getCollection('tips', ({ data }) => !data.draft);
  return tips.map((tip) => ({ params: { slug: tip.id }, props: { tip } }));
}

const { tip } = Astro.props;
const { Content, headings } = await render(tip);
const { title, description, topic, updated, sources } = tip.data;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const toc = headings.filter((h) => h.depth === 2);
const related = (await getCollection('tips', ({ data }) => !data.draft))
  .filter((t) => t.data.topic === topic && t.id !== tip.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: updated.toISOString(),
  author: { '@type': 'Organization', name: 'Wellness Med Care' },
  publisher: { '@type': 'Organization', name: 'Wellness Med Care' },
  mainEntityOfPage: pageUrl,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Tips', item: new URL('/tips/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};
---

<Base title={title} description={description} jsonLd={[articleLd, breadcrumbLd]}>
  <article class="wrap" style="padding-top:2.5rem">
    <div class="article-layout">
      <div class="prose">
        <p class="eyebrow">{TOPICS[topic].label}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <div class="guide-meta">
          <span>Current as of {fmt(updated)}</span>
          <a class="pill" href={`/tips/#${topic}`}>{TOPICS[topic].label}</a>
        </div>

        <Content />

        {sources.length > 0 && <Sources sources={sources} updated={updated} />}
        <Support />
      </div>

      <aside class="article-rail" aria-label="Page navigation">
        {
          toc.length >= 2 && (
            <nav class="toc">
              <h2>On this page</h2>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        {
          related.length > 0 && (
            <nav>
              <h2>Related tips</h2>
              <ul>
                {related.map((t) => (
                  <li>
                    <a href={`/tips/${t.id}/`}>{t.data.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>
    </div>
  </article>
</Base>
