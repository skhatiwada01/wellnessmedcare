---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import Support from '../../components/Support.astro';
import { LAB_TESTS, PANELS, type PanelKey } from '../../data/labs';

// Only what the client script needs, to keep the inlined payload small.
const payload = LAB_TESTS.map((t) => ({
  slug: t.slug,
  name: t.name,
  panel: t.panel,
  measures: t.measures,
  ask: t.ask,
}));

const grouped = (Object.keys(PANELS) as PanelKey[])
  .map((key) => ({ key, label: PANELS[key].label, tests: LAB_TESTS.filter((t) => t.panel === key) }))
  .filter((g) => g.tests.length > 0);
---

<Base
  title="Build a Questions Sheet for Your Lab Results"
  description={`Pick from ${LAB_TESTS.length} tests, record your values, tick what you want to ask, add your own questions, and download a Word questionnaire for your appointment.`}
>
  <div class="wrap" style="padding-top:2.5rem">
    <div class="prose prose-center">
      <h1>Your lab results, and what to ask about them</h1>
      <p class="lede">
        Tick the tests on your report, note your values, choose the questions you want to
        ask, add your own, and download one questionnaire to take to your appointment.
      </p>

      <Callout tone="note" title="Nothing here is saved or sent">
        <p style="margin:0">
          This runs entirely in your browser. Your values are never transmitted to us and
          are gone when you close the tab. That is also why the sheet is yours to download
          rather than something we keep for you.
        </p>
      </Callout>

      <Callout tone="warn" title="This does not interpret your results">
        <p style="margin:0">
          We do not judge whether your numbers are high or low - that depends on the
          reference range printed on your own report and on everything your clinician
          knows about you. What this builds is a record of your values and a list of good
          questions to ask about them.
        </p>
      </Callout>
    </div>

    <div class="prose prose-center" style="max-width:80ch">
      <form class="tool" id="lab-form" autocomplete="off">
        <h2 style="margin-top:0">1. Pick your tests</h2>

        <div class="search-box" style="margin:1rem 0">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <label class="skip" for="test-search">Search tests</label>
          <input id="test-search" type="search" placeholder={`Search ${LAB_TESTS.length} tests - "ALT", "thyroid", "iron"...`} autocomplete="off" />
        </div>
        <p class="search-empty" id="test-empty">No test matches that. Try an abbreviation from your report or a broader word.</p>

        {
          grouped.map((g) => (
            <fieldset class="panel-group" data-panel={g.key}>
              <legend>{g.label}</legend>
              <div class="check-grid">
                {g.tests.map((t) => (
                  <label class="check" data-search={`${t.name} ${t.slug}`.toLowerCase()}>
                    <input type="checkbox" name="test" value={t.slug} />
                    <span>{t.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }

        <h2 style="margin-top:2rem">2. Record your values (optional)</h2>
        <p style="color:var(--text-muted);font-size:.92rem">
          Copy the number and units exactly as printed on your report. Leave blank to get
          the questions without the values.
        </p>
        <div id="value-fields" class="value-fields">
          <p class="empty-note">Select a test above to record its value here.</p>
        </div>

        <h2 style="margin-top:2rem">3. Choose the questions</h2>
        <p style="color:var(--text-muted);font-size:.92rem">
          Every selected test gets its own suggested questions - untick any you do not
          want. Two standing questions are included for each test as checkboxes on the
          sheet: <em>does this change anything about my care?</em> and
          <em>does it need repeating, and when?</em>
        </p>
        <div id="question-picker">
          <p class="empty-note">Select a test above to see its questions here.</p>
        </div>

        <div class="field" style="margin-top:1.25rem">
          <label for="custom-questions">Your own questions (one per line)</label>
          <textarea
            id="custom-questions"
            rows="4"
            placeholder="Anything else you want to remember to ask - one question per line."
            style="width:100%;font:inherit;padding:.6rem .75rem;border:1px solid var(--border);border-radius:7px;background:var(--bg);color:var(--text);resize:vertical"
          ></textarea>
        </div>

        <h2 style="margin-top:2rem">4. Get your questionnaire</h2>
        <div class="field" style="max-width:22rem">
          <label for="patient-name">Name for the sheet (optional)</label>
          <input id="patient-name" type="text" placeholder="Leave blank if you prefer" />
        </div>
        <div class="tool-actions">
          <button class="btn" type="button" id="download-docx">Download as Word</button>
          <button class="btn btn-ghost" type="button" id="print-sheet">Print</button>
          <button class="btn btn-ghost" type="reset">Clear</button>
        </div>
      </form>

      <section id="preview" class="tool" hidden>
        <h2>Preview</h2>
        <div id="preview-body"></div>
      </section>

      <Support context="tool" />
    </div>
  </div>

  <script type="application/json" id="lab-data" set:html={JSON.stringify(payload)} is:inline />
  <script>
  // docx is ~350KB - loaded only when the download button is clicked.
  const loadDocx = () => import('../../scripts/docx');

  interface LabLite {
    slug: string;
    name: string;
    panel: string;
    measures: string;
    ask: string[];
  }

  const data: LabLite[] = JSON.parse(
    document.getElementById('lab-data')?.textContent ?? '[]',
  );
  const bySlug = new Map(data.map((t) => [t.slug, t]));

  const form = document.getElementById('lab-form') as HTMLFormElement;
  const valueFields = document.getElementById('value-fields')!;
  const questionPicker = document.getElementById('question-picker')!;
  const preview = document.getElementById('preview') as HTMLElement;
  const previewBody = document.getElementById('preview-body')!;

  const escAttr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

  const selected = () =>
    [...form.querySelectorAll<HTMLInputElement>('input[name="test"]:checked')].map(
      (i) => i.value,
    );

  // ---- search over the checkbox list ----------------------------------
  const search = document.getElementById('test-search') as HTMLInputElement;
  const emptyNote = document.getElementById('test-empty') as HTMLElement;
  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    form.querySelectorAll<HTMLElement>('.check').forEach((label) => {
      // Checked tests stay visible so a selection is never hidden by the filter.
      const checked = label.querySelector<HTMLInputElement>('input')!.checked;
      const hit = !q || checked || (label.dataset.search ?? '').includes(q);
      label.style.display = hit ? '' : 'none';
      if (hit) visible++;
    });
    form.querySelectorAll<HTMLElement>('.panel-group').forEach((group) => {
      const any = [...group.querySelectorAll<HTMLElement>('.check')].some(
        (c) => c.style.display !== 'none',
      );
      group.style.display = any ? '' : 'none';
    });
    emptyNote.style.display = visible === 0 ? 'block' : 'none';
  });

  // ---- values ----------------------------------------------------------
  const currentValues = () => {
    const map = new Map<string, string>();
    valueFields.querySelectorAll<HTMLInputElement>('input[data-slug]').forEach((i) => {
      if (i.value.trim()) map.set(i.dataset.slug!, i.value.trim());
    });
    return map;
  };

  function renderValueFields() {
    const slugs = selected();
    const kept = currentValues();

    if (slugs.length === 0) {
      valueFields.innerHTML =
        '<p class="empty-note">Select a test above to record its value here.</p>';
      return;
    }

    valueFields.innerHTML = slugs
      .map((slug) => {
        const t = bySlug.get(slug)!;
        const v = kept.get(slug) ?? '';
        return `<div class="field">
            <label for="val-${slug}">${t.name}</label>
            <input id="val-${slug}" data-slug="${slug}" type="text"
                   value="${escAttr(v)}"
                   placeholder="e.g. 5.4 (units as printed)" />
          </div>`;
      })
      .join('');
  }

  // ---- per-test question picker ---------------------------------------
  const uncheckedQuestions = new Set<string>(); // "slug::index" of questions turned OFF

  function renderQuestionPicker() {
    const slugs = selected();
    if (slugs.length === 0) {
      questionPicker.innerHTML =
        '<p class="empty-note">Select a test above to see its questions here.</p>';
      return;
    }
    questionPicker.innerHTML = slugs
      .map((slug) => {
        const t = bySlug.get(slug)!;
        const items = t.ask
          .map((q, i) => {
            const key = `${slug}::${i}`;
            const on = !uncheckedQuestions.has(key);
            return `<label class="check q-check">
                <input type="checkbox" data-qkey="${key}" ${on ? 'checked' : ''} />
                <span>${escAttr(q)}</span>
              </label>`;
          })
          .join('');
        return `<div class="q-group"><p class="q-title">${t.name}</p>${items}</div>`;
      })
      .join('');
  }

  questionPicker.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (!input.dataset.qkey) return;
    if (input.checked) uncheckedQuestions.delete(input.dataset.qkey);
    else uncheckedQuestions.add(input.dataset.qkey);
    refreshPreview();
  });

  // ---- sheet building --------------------------------------------------
  function customQuestions(): string[] {
    return (document.getElementById('custom-questions') as HTMLTextAreaElement).value
      .split('\n')
      .map((l) => l.trim())
      .filter(Boolean);
  }

  function buildSheet(): { text: string; html: string } | null {
    const slugs = selected();
    const custom = customQuestions();
    if (slugs.length === 0 && custom.length === 0) return null;

    const name = (document.getElementById('patient-name') as HTMLInputElement).value.trim();
    const values = currentValues();

    const lines: string[] = [];
    const html: string[] = [];

    lines.push('MY LAB RESULTS - QUESTIONS FOR MY APPOINTMENT');
    lines.push('');
    if (name) lines.push(`Name: ${name}`);
    lines.push('Date of lab report: ____________________');
    lines.push('Appointment date: ______________________');
    lines.push('');
    lines.push('Note: the reference range that applies to me is printed on my own lab');
    lines.push('report. This sheet does not interpret my results.');
    lines.push('');

    for (const slug of slugs) {
      const t = bySlug.get(slug)!;
      const v = values.get(slug);
      const kept = t.ask.filter((_, i) => !uncheckedQuestions.has(`${slug}::${i}`));

      lines.push('----------------------------------------------------------');
      lines.push(t.name.toUpperCase());
      lines.push(`My result: ${v ? v : '________________'}    My lab's range: ________________`);
      lines.push('');
      lines.push(`What it measures: ${t.measures}`);
      lines.push('');
      kept.forEach((q) => lines.push(`  [ ] ${q}`));
      lines.push('  [ ] Does this change anything about my care?');
      lines.push('  [ ] Needs repeating?  When: ______________________');
      lines.push('');

      html.push(`<div class="preview-test">
          <h3>${escAttr(t.name)}</h3>
          <p><strong>My result:</strong> ${v ? escAttr(v) : '(not recorded)'}</p>
          <ul>${kept.map((q) => `<li>${escAttr(q)}</li>`).join('')}
            <li>Does this change anything about my care?</li>
            <li>Needs repeating? When: ____</li>
          </ul>
        </div>`);
    }

    lines.push('----------------------------------------------------------');
    lines.push('MY OWN QUESTIONS');
    lines.push('');
    if (custom.length > 0) {
      custom.forEach((q) => lines.push(`  [ ] ${q}`));
    } else {
      lines.push('_________________________________________________________');
      lines.push('');
      lines.push('_________________________________________________________');
    }
    lines.push('');
    lines.push('Next step agreed at the appointment: ____________________________');
    lines.push('Who does it: ____________________  By when: ____________________');

    if (custom.length > 0) {
      html.push(`<div class="preview-test"><h3>My own questions</h3>
        <ul>${custom.map((q) => `<li>${escAttr(q)}</li>`).join('')}</ul></div>`);
    }

    return { text: lines.join('\n'), html: html.join('') };
  }

  function refreshPreview() {
    const sheet = buildSheet();
    if (!sheet) {
      preview.hidden = true;
      return;
    }
    preview.hidden = false;
    previewBody.innerHTML = sheet.html;
  }

  form.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).matches('input[name="test"]')) {
      renderValueFields();
      renderQuestionPicker();
    }
    refreshPreview();
  });
  form.addEventListener('input', refreshPreview);
  form.addEventListener('reset', () =>
    setTimeout(() => {
      uncheckedQuestions.clear();
      renderValueFields();
      renderQuestionPicker();
      refreshPreview();
      search.dispatchEvent(new Event('input'));
    }, 0),
  );

  document.getElementById('download-docx')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const sheet = buildSheet();
    if (!sheet) {
      btn.textContent = 'Pick a test first';
      setTimeout(() => (btn.textContent = 'Download as Word'), 2000);
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Preparing...';
    try {
      const { downloadLetter } = await loadDocx();
      await downloadLetter(sheet.text, 'my-lab-results-questions.docx');
      btn.textContent = 'Downloaded';
    } catch {
      btn.textContent = 'Download failed';
    }
    setTimeout(() => {
      btn.disabled = false;
      btn.textContent = 'Download as Word';
    }, 2000);
  });

  document.getElementById('print-sheet')?.addEventListener('click', () => window.print());
</script>
</Base>



<style>
  .panel-group {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
    margin: 0 0 1rem;
  }
  .panel-group legend {
    padding: 0 0.45rem;
    font-weight: 650;
    font-size: 0.88rem;
  }
  .check-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.93rem;
    cursor: pointer;
  }
  .check input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent);
    flex: none;
  }
  .value-fields {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .empty-note {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
    grid-column: 1 / -1;
  }
  .q-group {
    border-top: 1px solid var(--border);
    padding: 0.75rem 0 0.35rem;
  }
  .q-title {
    font-weight: 650;
    font-size: 0.9rem;
    margin: 0 0 0.45rem;
  }
  .q-check {
    margin-bottom: 0.35rem;
    align-items: flex-start;
  }
  .q-check input {
    margin-top: 0.2rem;
  }
  .preview-test {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: 1rem;
  }
  .preview-test h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }
  .preview-test p {
    margin: 0 0 0.5rem;
  }
  .preview-test ul {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.93rem;
  }
</style>
