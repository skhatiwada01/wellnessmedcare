---
import Base from '../layouts/Base.astro';
---

<Base
  title="Search"
  description="Search every guide, lab test explanation, tracker, template, and tip on Wellness Med Care."
>
  <div class="wrap" style="padding-top:2.5rem">
    <div class="prose prose-center">
      <h1>Search</h1>
      <p class="lede">
        Every guide, lab test, tracker, letter template, glossary term, and tip on the
        site. Search runs entirely in your browser.
      </p>
      <div id="search"></div>
      <noscript>
        <p>
          Search needs JavaScript. Without it, try the
          <a href="/guides/">guides index</a>, the <a href="/understand/">lab test
          reference</a>, or the <a href="/glossary/">glossary</a>.
        </p>
      </noscript>
      <p id="search-unavailable" hidden>
        Search is not available in this preview build. On the live site this page
        searches all content. Meanwhile, try the <a href="/guides/">guides index</a>,
        the <a href="/understand/">lab test reference</a>, or the
        <a href="/glossary/">glossary</a>.
      </p>
    </div>
  </div>
</Base>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline>
  // The /pagefind/ bundle is generated by `pagefind --site dist` after the Astro
  // build, so it exists on deployed builds but not in `astro dev`.
  (function () {
    var s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.onload = function () {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        autofocus: true,
      });
    };
    s.onerror = function () {
      document.getElementById('search-unavailable').hidden = false;
    };
    document.head.appendChild(s);
  })();
</script>

<style is:global>
  /* Blend Pagefind's default UI into the site's tokens, both themes. */
  :root {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-alt);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 10px;
    --pagefind-ui-font: inherit;
  }
</style>
