---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist." noindex={true}>
  <div class="wrap" style="padding-top:4rem">
    <div class="prose prose-center">
      <h1>We could not find that page</h1>
      <p class="lede">The link may be old, or we may have moved something.</p>
      <p>
        Try the <a href="/guides/">guides index</a>, or look the term up in the
        <a href="/glossary/">glossary</a>.
      </p>
    </div>
  </div>
</Base>
