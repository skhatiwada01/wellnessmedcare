---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import Support from '../../components/Support.astro';
import { TRACKERS, TRACKER_CATEGORIES, type TrackerCategory } from '../../data/trackers';

const payload = TRACKERS.map(({ slug, title, intro, columns, notes }) => ({
  slug,
  title,
  intro,
  columns,
  notes: notes ?? [],
}));

const grouped = (Object.keys(TRACKER_CATEGORIES) as TrackerCategory[])
  .map((key) => ({
    key,
    ...TRACKER_CATEGORIES[key],
    items: TRACKERS.filter((t) => t.category === key),
  }))
  .filter((g) => g.items.length > 0);
---

<Base
  title="Printable Health Trackers"
  description={`${TRACKERS.length} free blank tracking sheets: blood sugar, blood pressure, medications, symptoms, mood, pregnancy, recovery and more. Print or download several at once.`}
>
  <div class="wrap" style="padding-top:2.5rem">
    <div class="prose">
      <h1>Printable trackers</h1>
      <p class="lede">
        {TRACKERS.length} blank sheets for keeping your own records between appointments.
        Print or download any one directly - or tick several and get them as one print
        job or a single Word file, each sheet on its own page.
      </p>

      <Callout tone="note" title="These are yours, not ours">
        <p style="margin:0">
          The files are generated on your device and the printing happens from your
          browser. We never see what you write in them, because you fill them in after
          they leave us. Health records you keep are safest when nobody else holds them.
        </p>
      </Callout>

      <Callout tone="warn" title="Blank forms, not targets">
        <p style="margin:0">
          These sheets contain no target ranges, thresholds, or guidance on what a
          reading should be. What your numbers mean, and what to do about them, is a
          conversation with your clinician. The sheet just makes sure you arrive with the
          facts.
        </p>
      </Callout>
    </div>

    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <label class="skip" for="tracker-search">Search trackers</label>
      <input id="tracker-search" type="search" placeholder={`Search ${TRACKERS.length} trackers...`} autocomplete="off" />
    </div>
    <p class="search-empty" id="tracker-empty">
      Nothing matches. Try a broader word - "blood", "log", "pain" - or clear the search.
    </p>

    {
      grouped.map((g) => (
        <section class="section tracker-section" id={g.key} style="margin-top:2.5rem">
          <h2>{g.label}</h2>
          <p style="color:var(--text-muted);max-width:62ch">{g.blurb}</p>
          <div class="hub-grid" style="margin-top:1.25rem">
            {g.items.map((t) => (
              <article
                class="card tracker-card"
                data-slug={t.slug}
                data-search={`${t.title} ${t.useCase} ${t.columns.join(' ')}`.toLowerCase()}
              >
                <div class="tracker-head">
                  <h3 style="margin:0">{t.title}</h3>
                  <label class="pick">
                    <input type="checkbox" data-pick={t.slug} />
                    <span>Select</span>
                  </label>
                </div>
                <p>{t.useCase}</p>

                <div class="field" style="margin:.9rem 0 .4rem">
                  <label for={`rows-${t.slug}`}>How many rows?</label>
                  <select id={`rows-${t.slug}`} data-rows>
                    {t.rowOptions.map((n) => (
                      <option value={n} selected={n === t.defaultRows}>
                        {n} rows
                      </option>
                    ))}
                  </select>
                </div>

                <div class="tool-actions" style="margin-top:.4rem">
                  <button class="btn" type="button" data-action="print">Print</button>
                  <button class="btn btn-ghost" type="button" data-action="docx">Word</button>
                  <button class="btn btn-ghost" type="button" data-action="csv">CSV</button>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <div class="prose" style="margin-top:3rem">
      <h2>Which one should you bring?</h2>
      <p>
        If you only ever download one thing from this site, make it the
        <strong>medication and supplement list</strong>. It is the document clinicians
        most often wish patients had, it prevents duplicate prescribing, and it matters
        most in exactly the situation where you are least able to recite it from memory.
      </p>
      <p>
        For a specific review, ask the office how many days of records they want before
        you start. Two weeks is a common request for blood pressure and sleep; a diabetes
        review often wants whatever span sits between appointments. And if one
        appointment needs several sheets - a medication list, a symptom diary, and the
        notes page is a common trio - select them all and print once.
      </p>
      <Support context="tool" />
    </div>
  </div>

  <div class="batch-bar" id="batch-bar" role="region" aria-label="Selected trackers" hidden>
    <p><strong id="batch-count">0 selected</strong><span id="batch-names"></span></p>
    <div class="batch-actions">
      <button class="btn" type="button" id="batch-print">Print selected</button>
      <button class="btn btn-ghost" type="button" id="batch-docx">One Word file</button>
      <button class="btn btn-ghost" type="button" id="batch-clear">Clear</button>
    </div>
  </div>

  <div id="print-area" aria-hidden="true"></div>

  <script type="application/json" id="tracker-data" set:html={JSON.stringify(payload)} is:inline />
  <script>
  // docx is ~350KB - loaded only when a download button is clicked.
  const loadDocx = () => import('../../scripts/docx');

  interface TrackerLite {
    slug: string;
    title: string;
    intro: string;
    columns: string[];
    notes: string[];
  }

  const data: TrackerLite[] = JSON.parse(
    document.getElementById('tracker-data')?.textContent ?? '[]',
  );
  const bySlug = new Map(data.map((t) => [t.slug, t]));

  const rowsFor = (slug: string) =>
    Number((document.getElementById(`rows-${slug}`) as HTMLSelectElement).value);

  // ---- search ----------------------------------------------------------
  const search = document.getElementById('tracker-search') as HTMLInputElement;
  const emptyNote = document.getElementById('tracker-empty') as HTMLElement;

  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.tracker-card').forEach((card) => {
      // Selected cards stay visible so a selection is never hidden by the filter.
      const picked = card.querySelector<HTMLInputElement>('input[data-pick]')!.checked;
      const hit = !q || picked || (card.dataset.search ?? '').includes(q);
      card.style.display = hit ? '' : 'none';
      if (hit) visible++;
    });
    document.querySelectorAll<HTMLElement>('.tracker-section').forEach((section) => {
      const any = [...section.querySelectorAll<HTMLElement>('.tracker-card')].some(
        (c) => c.style.display !== 'none',
      );
      section.style.display = any ? '' : 'none';
    });
    emptyNote.style.display = visible === 0 ? 'block' : 'none';
  });

  // ---- print rendering -------------------------------------------------
  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  function trackerPrintHTML(spec: TrackerLite, rows: number): string {
    const headerCells = spec.columns.map((c) => `<th>${esc(c)}</th>`).join('');
    const bodyRow = `<tr>${spec.columns.map(() => '<td>&nbsp;</td>').join('')}</tr>`;
    return `<section class="print-page">
      <h1>${esc(spec.title)}</h1>
      <p class="print-intro">${esc(spec.intro)}</p>
      <p class="print-meta">Name: ______________________________&nbsp;&nbsp;&nbsp;&nbsp;Date range: ____________________</p>
      <table>
        <thead><tr>${headerCells}</tr></thead>
        <tbody>${bodyRow.repeat(rows)}</tbody>
      </table>
      ${spec.notes.map((n) => `<p class="print-notes">${esc(n)}</p>`).join('')}
      <p class="print-footer">Created with wellnessmedcare.com. This document is for your own records. It is not medical advice.</p>
    </section>`;
  }

  function printSpecs(specs: { spec: TrackerLite; rows: number }[]) {
    const area = document.getElementById('print-area')!;
    area.innerHTML = specs.map(({ spec, rows }) => trackerPrintHTML(spec, rows)).join('');
    document.body.classList.add('printing-tracker');
    window.print();
    window.addEventListener(
      'afterprint',
      () => document.body.classList.remove('printing-tracker'),
      { once: true },
    );
  }

  // ---- multi-select ----------------------------------------------------
  const bar = document.getElementById('batch-bar') as HTMLElement;
  const countEl = document.getElementById('batch-count')!;
  const namesEl = document.getElementById('batch-names')!;

  const picked = (): string[] =>
    [...document.querySelectorAll<HTMLInputElement>('input[data-pick]:checked')].map(
      (i) => i.dataset.pick!,
    );

  function refreshBar() {
    const slugs = picked();
    bar.hidden = slugs.length === 0;
    countEl.textContent = `${slugs.length} selected`;
    const names = slugs.map((s) => bySlug.get(s)!.title);
    namesEl.textContent =
      names.length > 0
        ? ': ' + (names.length <= 3 ? names.join(', ') : names.slice(0, 3).join(', ') + ` and ${names.length - 3} more`)
        : '';
  }

  document.querySelectorAll<HTMLInputElement>('input[data-pick]').forEach((cb) => {
    cb.addEventListener('change', () => {
      cb.closest('.tracker-card')?.classList.toggle('is-picked', cb.checked);
      refreshBar();
    });
  });

  document.getElementById('batch-clear')!.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('input[data-pick]:checked').forEach((cb) => {
      cb.checked = false;
      cb.closest('.tracker-card')?.classList.remove('is-picked');
    });
    refreshBar();
    search.dispatchEvent(new Event('input'));
  });

  document.getElementById('batch-print')!.addEventListener('click', () => {
    const specs = picked().map((slug) => ({ spec: bySlug.get(slug)!, rows: rowsFor(slug) }));
    if (specs.length > 0) printSpecs(specs);
  });

  document.getElementById('batch-docx')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const specs = picked().map((slug) => ({ ...bySlug.get(slug)!, rows: rowsFor(slug) }));
    if (specs.length === 0) return;
    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Preparing...';
    try {
      const { downloadTrackerBundle } = await loadDocx();
      await downloadTrackerBundle(specs, 'health-trackers.docx');
      btn.textContent = 'Downloaded';
    } catch {
      btn.textContent = 'Failed';
    }
    setTimeout(() => {
      btn.disabled = false;
      btn.textContent = original;
    }, 2000);
  });

  // ---- per-card actions ------------------------------------------------
  document.querySelectorAll<HTMLElement>('.tracker-card').forEach((card) => {
    const spec = bySlug.get(card.dataset.slug!)!;
    const rowSelect = card.querySelector<HTMLSelectElement>('select[data-rows]')!;

    card.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const rows = Number(rowSelect.value);

        if (btn.dataset.action === 'print') {
          printSpecs([{ spec, rows }]);
          return;
        }

        const original = btn.textContent;
        btn.disabled = true;
        btn.textContent = '...';
        try {
          const { downloadTracker, downloadCsv } = await loadDocx();
          if (btn.dataset.action === 'docx') {
            await downloadTracker({ ...spec, rows }, `${spec.slug}-tracker.docx`);
          } else {
            downloadCsv(spec.columns, rows, `${spec.slug}-tracker.csv`);
          }
          btn.textContent = 'Done';
        } catch {
          btn.textContent = 'Failed';
        }
        setTimeout(() => {
          btn.disabled = false;
          btn.textContent = original;
        }, 1800);
      });
    });
  });
</script>
</Base>



<style>
  .tracker-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pick {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    font-size: 0.82rem;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    user-select: none;
  }
  .pick input {
    width: 0.95rem;
    height: 0.95rem;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .tracker-card.is-picked {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .tracker-card .field label {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .tracker-card select {
    width: auto;
    min-width: 8rem;
  }
  .tracker-card .tool-actions .btn {
    padding: 0.4rem 0.9rem;
    font-size: 0.9rem;
  }

  .batch-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 1.5rem;
    padding: 0.8rem 1.25rem;
    background: var(--surface);
    border-top: 1px solid var(--border);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  }
  .batch-bar[hidden] {
    display: none;
  }
  .batch-bar p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 56ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .batch-actions {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }
  .batch-actions .btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.9rem;
  }
  @media print {
    .batch-bar {
      display: none !important;
    }
  }
</style>
