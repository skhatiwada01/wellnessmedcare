---
/**
 * Analytics, configured at BUILD time (see .env.example).
 *
 * - GA_MEASUREMENT_ID (site default in src/site-config.ts, overridable via
 *   PUBLIC_GA_MEASUREMENT_ID): Google Analytics 4, loaded on every page view.
 *   A visitor can opt out per device from the privacy page; the opt-out uses
 *   Google's documented `ga-disable-<ID>` flag, which must be set before
 *   gtag('config') runs - hence the localStorage check first.
 * - PUBLIC_GOATCOUNTER_CODE: optional cookieless pageview counts.
 *
 * Editorial rule (CONTENT.md): analytics must never carry values a reader typed
 * into a tool. Pageviews only - do not add custom events for tool inputs.
 */
import { GA_MEASUREMENT_ID, GOATCOUNTER_CODE } from '../site-config';

const gaId = GA_MEASUREMENT_ID;
const goatcounter = GOATCOUNTER_CODE;
---

{
  gaId && (
    <>
      <script is:inline define:vars={{ gaId }}>
        try {
          if (localStorage.getItem('wmc-analytics-optout') === '1') {
            window['ga-disable-' + gaId] = true;
          }
        } catch (e) {}
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    </>
  )
}

{
  goatcounter && (
    <script
      is:inline
      data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
      async
      src="https://gc.zgo.at/count.js"
    />
  )
}
