---
import Base from './Base.astro';
import Sources from '../components/Sources.astro';
import Support from '../components/Support.astro';
import { PILLARS } from '../content.config';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  guide: CollectionEntry<'guides'>;
  headings?: MarkdownHeading[];
}
const { guide, headings = [] } = Astro.props;
const { title, description, pillar, updated, sources } = guide.data;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const toc = headings.filter((h) => h.depth === 2);
const related = (await getCollection('guides', ({ data }) => !data.draft))
  .filter((g) => g.data.pillar === pillar && g.id !== guide.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: updated.toISOString(),
  author: { '@type': 'Organization', name: 'Wellness Med Care' },
  publisher: { '@type': 'Organization', name: 'Wellness Med Care' },
  mainEntityOfPage: pageUrl,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Guides', item: new URL('/guides/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};
---

<Base title={title} description={description} jsonLd={[articleLd, breadcrumbLd]}>
  <article class="wrap" style="padding-top:2.5rem">
    <div class="article-layout">
      <div class="prose">
        <p class="eyebrow">{PILLARS[pillar].label}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <div class="guide-meta">
          <span>Current as of {fmt(updated)}</span>
          <a class="pill" href={`/guides/#${pillar}`}>{PILLARS[pillar].label}</a>
        </div>

        <slot />

        <Sources sources={sources} updated={updated} />
        <Support context="guide" />
      </div>

      <aside class="article-rail" aria-label="Page navigation">
        {
          toc.length >= 2 && (
            <nav class="toc">
              <h2>On this page</h2>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        {
          related.length > 0 && (
            <nav>
              <h2>Related guides</h2>
              <ul>
                {related.map((g) => (
                  <li>
                    <a href={`/guides/${g.id}/`}>{g.data.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>
    </div>
  </article>
</Base>
