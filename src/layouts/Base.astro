---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PUBLISHED_LOCALES, LOCALES, localePath, parsePath, DEFAULT_LOCALE } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Set true on pages that should stay out of search results. */
  noindex?: boolean;
  /** Extra schema.org objects to emit alongside the Organization block. */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;

/**
 * Cookieless analytics. Create a free GoatCounter account (goatcounter.com), then set
 * this to your code (e.g. 'wellnessmedcare'). While empty, no analytics script loads.
 * GoatCounter sets no cookies and stores no personal data, so no consent banner is
 * needed - and it must stay that way; see CONTENT.md on tracking.
 */
const GOATCOUNTER_CODE = '';

const { locale, rest } = parsePath(Astro.url.pathname);
const t = useTranslations(locale);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'Wellness Med Care' ? title : `${title} | Wellness Med Care`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Wellness Med Care',
  url: Astro.site?.href,
  description:
    'Plain-English guides, free tools, and health reference material for understanding US medical bills, insurance, lab reports, and healthcare prices.',
};
---

<!doctype html>
<html lang={locale} dir={LOCALES[locale].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Runs before first paint so a dark-mode reader never sees a white flash. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      PUBLISHED_LOCALES.map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={new URL(localePath(rest, code), Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(rest, DEFAULT_LOCALE), Astro.site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Wellness Med Care" />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={new URL('/og-default.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wellness Med Care - plain-English help with bills, insurance, lab reports, and prices" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-default.png', Astro.site).href} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {GOATCOUNTER_CODE && (
      <script
        is:inline
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t('action.skip')}</a>
    <Header />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
