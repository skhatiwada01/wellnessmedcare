---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { PUBLISHED_LOCALES, LOCALES, localePath, parsePath, DEFAULT_LOCALE } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Set true on pages that should stay out of search results. */
  noindex?: boolean;
  /** Extra schema.org objects to emit alongside the Organization block. */
  jsonLd?: Record<string, unknown>[];
  /** Set on article pages (guides/tips) to emit og:type article + timestamps. */
  article?: { published: string; modified: string };
}
const { title, description, noindex = false, jsonLd = [], article } = Astro.props;


const { locale, rest } = parsePath(Astro.url.pathname);
const t = useTranslations(locale);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.startsWith('Wellness Med Care') ? title : `${title} | Wellness Med Care`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#org', Astro.site).href,
  name: 'Wellness Med Care',
  url: Astro.site?.href,
  description:
    'Plain-English guides, free tools, and health reference material for understanding US medical bills, insurance, lab reports, and healthcare prices.',
  logo: {
    '@type': 'ImageObject',
    url: new URL('/logo-512.png', Astro.site).href,
    width: 512,
    height: 512,
  },
  email: 'support@sisrallc.com',
};
---

<!doctype html>
<html lang={locale} dir={LOCALES[locale].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Runs before first paint so a dark-mode reader never sees a white flash. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>

    <Analytics />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      /* hreflang only means something once a second locale exists. */
      PUBLISHED_LOCALES.length > 1 && (
        <>
          {PUBLISHED_LOCALES.map((code) => (
            <link
              rel="alternate"
              hreflang={code}
              href={new URL(localePath(rest, code), Astro.site).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localePath(rest, DEFAULT_LOCALE), Astro.site).href}
          />
        </>
      )
    }

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Wellness Med Care" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : locale} />
    <meta property="og:image" content={new URL('/og-default.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wellness Med Care - plain-English help with bills, insurance, lab reports, and prices" />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-default.png', Astro.site).href} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Wellness Med Care" href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t('action.skip')}</a>
    <Header />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Tool forms have no action on purpose - nothing typed may leave the page.
      // This also blocks implicit Enter-key submission, which would otherwise put
      // typed values into the URL querystring (and server logs).
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (form instanceof HTMLFormElement && !form.getAttribute('action')) {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>
