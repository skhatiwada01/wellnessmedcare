---
import Base from './Base.astro';
import Support from '../components/Support.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  lede: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, h1, lede, jsonLd = [] } = Astro.props;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Tools', item: new URL('/tools/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: h1, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Base title={title} description={description} jsonLd={[...jsonLd, breadcrumbLd]}>
  <div class="wrap" style="padding-top:2.5rem">
    <div class="prose" style="max-width:none">
      <h1>{h1}</h1>
      <p class="lede" style="max-width:60ch">{lede}</p>
    </div>

    <div class="tool-layout">
      <slot name="tool" />
      <div class="tool-side prose">
        <slot />
        <Support context="tool" />
      </div>
    </div>
  </div>
</Base>
